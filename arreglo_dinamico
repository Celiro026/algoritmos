class PilaDinamicaContenedores:

    def __init__(self, capacidad_inicial=2):
        self.pila = [None] * capacidad_inicial
        self.capacidad = capacidad_inicial
        self.tope = -1

    def esta_vacia(self):
        return self.tope == -1
    def redimensionar(self):
        nueva_pila = [None] * (2 * self.capacidad)
        for i in range(self.tope + 1):
            nueva_pila[i] = self.pila[i]
        self.pila = nueva_pila
        self.capacidad *= 2
        print("La capacidad aumentó a:", self.capacidad)

    def push(self, contenedor):
        if self.tope == self.capacidad - 1:
            self.redimensionar()
        self.tope += 1
        self.pila[self.tope] = contenedor

    def pop(self):
        if self.esta_vacia():
            raise IndexError("No hay contenedores para retirar")

        contenedor = self.pila[self.tope]
        self.pila[self.tope] = None
        self.tope -= 1

        return contenedor

    def peek(self):

        if self.esta_vacia():
            raise IndexError("La pila está vacía")

        return self.pila[self.tope]

    def size(self):
        return self.tope + 1

    def __str__(self):
        return str(self.pila[:self.tope + 1])


def demo_contenedores_dinamicos():

    barco = PilaDinamicaContenedores(2)

    print("Capacidad inicial:", barco.capacidad)

    contenedores = [
        "CONT-001",
        "CONT-002",
        "CONT-003",
        "CONT-004",
        "CONT-005"
    ]
    print("\nCargando contenedores:")
    for contenedor in contenedores:
        barco.push(contenedor)
        print("\nContenedor cargado:", contenedor)
        print("Pila:", barco)
        print("Capacidad:", barco.capacidad)
    print("\nContenedor superior:")
    print(barco.peek())
    print("\nDescargando contenedores:")
    while not barco.esta_vacia():
        contenedor = barco.pop()
        print("Contenedor descargado:", contenedor)
        print("Pila:", barco)

demo_contenedores_dinamicos()
